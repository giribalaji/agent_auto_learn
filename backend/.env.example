# =============================================================================
# agent_auto_learn backend — Environment template
# =============================================================================
# Copy this file to `.env` in the same directory and fill in real values:
#
#     cd backend
#     cp .env.example .env
#
# The real `.env` is gitignored. Never commit live keys.
# =============================================================================

# ---- LLM Provider Credentials ----------------------------------------------
# The backend uses a provider-agnostic OpenAI-compatible interface.
# The env var is named OPENROUTER_API_KEY for historical reasons, but it holds
# whichever provider's key you're pointing at via SUBSYNC_PROVIDER + SUBSYNC_BASE_URL.
#
# Supported providers: ollama, groq, openai, openrouter, anthropic (via openrouter)
OPENROUTER_API_KEY=replace_me_with_your_provider_api_key

# ---- Model & Provider Selection --------------------------------------------
SUBSYNC_MODEL=qwen3-next:80b
SUBSYNC_PROVIDER=ollama
SUBSYNC_BASE_URL=https://ollama.com/v1


# =============================================================================
# Provider Examples — uncomment the block that matches your setup
# =============================================================================

# ---- Ollama Cloud (default, shown above) -----------------------------------
# SUBSYNC_MODEL=qwen3-next:80b
# SUBSYNC_PROVIDER=ollama
# SUBSYNC_BASE_URL=https://ollama.com/v1
# Get key: https://ollama.com/settings/keys

# ---- Groq (fastest inference) ----------------------------------------------
# OPENROUTER_API_KEY=gsk_your_groq_key_here
# SUBSYNC_MODEL=llama-3.3-70b-versatile
# SUBSYNC_PROVIDER=groq
# SUBSYNC_BASE_URL=https://api.groq.com/openai/v1
# Get key: https://console.groq.com/keys

# ---- OpenRouter (aggregator, access to Claude/GPT/etc.) --------------------
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# SUBSYNC_MODEL=anthropic/claude-3.5-sonnet
# SUBSYNC_PROVIDER=openrouter
# SUBSYNC_BASE_URL=https://openrouter.ai/api/v1
# Get key: https://openrouter.ai/keys

# ---- OpenAI (direct) -------------------------------------------------------
# OPENROUTER_API_KEY=sk-proj-your_openai_key
# SUBSYNC_MODEL=gpt-4o
# SUBSYNC_PROVIDER=openai
# SUBSYNC_BASE_URL=https://api.openai.com/v1
# Get key: https://platform.openai.com/api-keys

# ---- Local Ollama (no cloud, runs on your machine) -------------------------
# OPENROUTER_API_KEY=not-needed
# SUBSYNC_MODEL=qwen2.5:14b
# SUBSYNC_PROVIDER=ollama
# SUBSYNC_BASE_URL=http://localhost:11434/v1
# Install: https://ollama.com/download
