# =============================================================================
# agent_auto_learn frontend — Environment template
# =============================================================================
# Copy to `.env.local` (Vite's default local-override file, gitignored):
#
#     cd frontend
#     cp .env.example .env.local
#
# Never commit `.env.local` — it holds live secrets.
# =============================================================================

# ---- Better Auth -----------------------------------------------------------
# Session-signing secret. Generate a fresh one with:
#     openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_generate_with_openssl_rand_base64_32

# ---- AI Gateway Configuration ----------------------------------------------
# Base URL of the AI gateway the frontend proxies LLM calls through.
# Default points at the local backend; override if you use a hosted gateway.
AI_GATEWAY_BASE_URL=http://localhost:8080

# Gateway auth token (only needed if your gateway requires one).
AI_GATEWAY_API_KEY=replace_me_with_your_gateway_key

# ---- Autumn (Payments / Subscription tracking) -----------------------------
# Autumn lets you track plan usage and bill against model spend.
# Get a test key at: https://useautumn.com  (uses `am_sk_test_` prefix)
# For production use the live key with `am_sk_live_` prefix.
AUTUMN_SECRET_KEY=am_sk_test_replace_me_with_your_autumn_key

# ---- Runable (optional — CLI launcher integration) -------------------------
# If you want the in-app "Run locally" button, create a Runable project and
# paste the CLI launch URL below. Leave unset to hide the button.
# RUNABLE_URL=https://api.runable.com/api/cli?key=rk_your_runable_key
